.DS_Store
.playwright-mcp/
__pycache__/
*.pyc
.venv/
node_modules/

# Portal build output. The site is derived from problems/; only the source and
# the emitted problems/index.db + index.json are committed.
dist/
.astro/

# Personal meal-system planning notes (not used by the app)
meal-system/meal-plan.md
meal-system/pantry-week1.md
meal-system/nutrient-cadence.md

# Meal planner runtime DB (lives on the server / locally, never in git)
meal-system/data/

# Private catalyst layer — relationship state, connection records, contact notes.
# Excluded at the filesystem level, not at render time, so the publish boundary
# holds before the portal build exists. NOT backed up by git — back this
# directory up separately. See problems/schema.md → The private layer.
problems/private/

# engine. Glob, not a literal: a second interpreter's venv
# (engine/.venv312) slipped past `engine/.venv/` on 2026-09-13.
engine/.venv*/
engine/tests/fixtures/live/

# Engine v2 graph. Committed as of 01-minimal.md §11 item 3b-B: corpus
# markdown is prose-only now, so graph.db is no longer derivable from it —
# it is the durable source the worker and human edits (engine/store/edit.py)
# write to directly, not a build artifact. WAL/SHM are still transient.
problems/graph.db-wal
problems/graph.db-shm
# Hand-taken safety copies from before a destructive migration. Now that
# graph.db is committed, git history is the backup; these are local only.
problems/graph.db.bak-*
.env

# PoC scratch database + fetch cache (a PoC run must leave no diff in a
# tracked db; this is a disposable copy of problems/graph.db)
engine/poc/poc2-scratch/
